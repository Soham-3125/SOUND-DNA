	@echo ... __/juce_build_tools/juce_build_tools.s
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d E:\Nanu\sound_dna_simple\sound_dna_simple\build\_deps\juce-build\tools && $(CMAKE_COMMAND) -P E:\Nanu\sound_dna_simple\sound_dna_simple\build\_deps\juce-build\tools\CMakeFiles\VerifyGlobs.cmake
	cd /d E:\Nanu\sound_dna_simple\sound_dna_simple\build\_deps\juce-build\tools && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

